# === Basic App Settings ===
APP_NAME=localhappey

# === API Endpoints ===
API_BASE_URL=http://127.0.0.1:5000
DEFAULT_CHAT_ENDPOINT=/api/chat
AGENT_ENDPOINT=http://127.0.0.1:5001
PLUGIN_EXTENSION_NAMESPACE=net.aihappey.agents

# Optional chatbot-wide default instructions injected into the root chat config.
CHATBOT_INSTRUCTIONS=- Use **Markdown formatting** for your responses, including tables and lists, unless specifically instructed to output CSV.\n- When outputting **Chart.js**, always include a valid JSON data object inside a chartjs code block.\n- When outputting **CSV**, always return raw CSV text inside a csv code block.\n- When outputting **LaTeX or math**, return a single formula inside a latex code block without delimiters.\n- Do **not** include base64 images; images are handled by the client.\n- Always respond in the user’s preferred language.

# Optional comma-separated or JSON-array list of MCP registry catalog URLs.
MCP_CATALOG_URLS=
