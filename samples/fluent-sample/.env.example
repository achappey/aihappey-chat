# === Basic App Settings ===
APP_NAME=Dev Chat

# === Optional Privacy Policy (example URL; replace before publishing) ===
# URL-only opens directly in a new tab. Set to empty to hide the footer link.
PRIVACY_POLICY_URL=https://example.com/privacy
# Optional Markdown file, relative to this sample, enables the themed policy page.
PRIVACY_POLICY_MARKDOWN_FILE=
# Inline Markdown takes precedence over the file, including an explicitly empty value.
# PRIVACY_POLICY_MARKDOWN="# Privacy policy\n\nYour policy text."

# === API Endpoints ===
CHAT_API_URL=http://localhost:3010/api/chat
AGENT_ENDPOINT=http://localhost:3037
MODELS_API_URL=http://localhost:3010/models
SAMPLING_API_URL=http://localhost:3010/sampling
CONVERSATIONS_API_URL=http://localhost:3021/conversations
TRANSCRIPTION_API=http://localhost:3010/api/transcription

# === Authentication (MSAL/Azure AD) ===
MSAL_CLIENT_ID=<clientid>
MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant_id>
MSAL_REDIRECT_URI=/
MSAL_SCOPES=["<scope>"]
CONVERSATIONS_SCOPES=["<scope>"]
