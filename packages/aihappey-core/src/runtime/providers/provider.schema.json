{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIHappey provider metadata",
  "description": "Static provider metadata only. Executable gateway handlers and computed icon fallbacks belong to the chat runtime.",
  "type": "object",
  "required": ["name"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "experimental": { "type": "boolean" },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src"],
        "additionalProperties": false,
        "properties": {
          "src": { "type": "string" },
          "mimeType": { "type": "string" },
          "sizes": { "type": "array", "items": { "type": "string" } },
          "theme": { "enum": ["light", "dark"] }
        }
      }
    },
    "urls": {
      "type": "object",
      "required": ["homepage"],
      "additionalProperties": false,
      "properties": {
        "homepage": { "type": "string" },
        "docs": { "type": "string" },
        "console": { "type": "string" },
        "termsOfService": { "type": "string" },
        "privacyPolicy": { "type": "string" },
        "pricing": { "type": "string" }
      }
    },
    "providerCountry": { "type": "string" },
    "inferenceRegions": { "type": "array", "items": { "type": "string" } },
    "category": { "enum": ["model_provider", "gateway_router", "inference_compute", "media_voice", "search_data", "app_tools"] },
    "apiBaseUrl": { "type": "string" },
    "chatEndpoints": { "type": "array", "items": { "type": "string" } }
  }
}
