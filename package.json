{
  "name": "aihappey-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "scripts": {
    "build": "npm run clean && node scripts/build-workspaces.cjs",
    "dev": "npm run -ws dev",
    "build:packages": "npm run -w packages --if-present build",
    "watch:packages": "npm run -w packages --if-present watch",
    "clean": "rimraf --glob \"packages/*/dist\" \"samples/*/dist\" \"samples/*/public/bundle.js\" \"samples/*/public/bundle.js.map\"",
    "test": "npm run build --workspace=aihappey-models && node --test scripts/*.test.cjs packages/aihappey-state/tests/*.test.mjs && npm test --workspace=aihappey-agents && npm test --workspace=aihappey-models"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true
  }
}
