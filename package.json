{
  "name": "aihappey-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "scripts": {
    "build": "npm run clean && node scripts/build-workspaces.cjs",
    "dev": "npm run -ws dev",
    "build:packages": "npm run -w packages --if-present build",
    "watch:packages": "npm run -w packages --if-present watch",
    "clean": "rimraf --glob \"packages/*/dist\" \"samples/*/dist\" \"samples/*/public/bundle.js\" \"samples/*/public/bundle.js.map\""
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.0.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@swc/core@1.15.47": true,
    "esbuild@0.28.2": true
  }
}
